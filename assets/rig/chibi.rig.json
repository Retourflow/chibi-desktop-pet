{
  "version": 1,
  "_comment": "Rig spec for the chibi character. Positions are relative to part rects (see chibi_pet/rig/spec.py), so this works for both the placeholder art and the final PSD.",

  "parameters": [
    {"id": "ParamAngleX", "min": -30, "max": 30, "default": 0},
    {"id": "ParamAngleY", "min": -30, "max": 30, "default": 0},
    {"id": "ParamAngleZ", "min": -30, "max": 30, "default": 0},
    {"id": "ParamEyeLOpen", "min": 0, "max": 1, "default": 1},
    {"id": "ParamEyeROpen", "min": 0, "max": 1, "default": 1},
    {"id": "ParamEyeBallX", "min": -1, "max": 1, "default": 0},
    {"id": "ParamEyeBallY", "min": -1, "max": 1, "default": 0},
    {"id": "ParamBrowLY", "min": -1, "max": 1, "default": 0},
    {"id": "ParamBrowRY", "min": -1, "max": 1, "default": 0},
    {"id": "ParamMouthOpenY", "min": 0, "max": 1, "default": 0},
    {"id": "ParamMouthForm", "min": -1, "max": 1, "default": 0},
    {"id": "ParamMouthA", "min": 0, "max": 1, "default": 0},
    {"id": "ParamMouthI", "min": 0, "max": 1, "default": 0},
    {"id": "ParamMouthU", "min": 0, "max": 1, "default": 0},
    {"id": "ParamMouthE", "min": 0, "max": 1, "default": 0},
    {"id": "ParamMouthO", "min": 0, "max": 1, "default": 0},
    {"id": "ParamBodyAngleX", "min": -10, "max": 10, "default": 0},
    {"id": "ParamBodyAngleY", "min": -10, "max": 10, "default": 0},
    {"id": "ParamBodyAngleZ", "min": -10, "max": 10, "default": 0},
    {"id": "ParamBreath", "min": 0, "max": 1, "default": 0},
    {"id": "ParamSway", "min": -1, "max": 1, "default": 0},

    {"id": "ParamHairFront", "min": -45, "max": 45, "default": 0},
    {"id": "ParamHairSide1", "min": -45, "max": 45, "default": 0},
    {"id": "ParamHairSide2", "min": -45, "max": 45, "default": 0},
    {"id": "ParamHairBack1", "min": -45, "max": 45, "default": 0},
    {"id": "ParamHairBack2", "min": -45, "max": 45, "default": 0},
    {"id": "ParamTail1", "min": -45, "max": 45, "default": 0},
    {"id": "ParamTail2", "min": -45, "max": 45, "default": 0},
    {"id": "ParamTail3", "min": -45, "max": 45, "default": 0},
    {"id": "ParamTassel1", "min": -45, "max": 45, "default": 0},
    {"id": "ParamTassel2", "min": -45, "max": 45, "default": 0},
    {"id": "ParamArmLSway", "min": -45, "max": 45, "default": 0},
    {"id": "ParamArmRSway", "min": -45, "max": 45, "default": 0}
  ],

  "deformers": [
    {"id": "body", "type": "rotation",
     "origin": {"part": "torso", "at": [0.5, 0.97]},
     "angle": {"ParamBodyAngleZ": 0.4},
     "translate": {"ParamBodyAngleX": {"canvas_h": [0.0012, 0]}, "ParamBodyAngleY": {"canvas_h": [0, -0.0006]}},
     "scale": {"ParamBreath": [0.0, 0.006]}},

    {"id": "head_roll", "type": "rotation", "parent": "body",
     "origin": {"part": "face", "at": [0.5, 1.0]},
     "angle": {"ParamAngleZ": 0.5},
     "translate": {"ParamAngleX": {"canvas_h": [0.0004, 0]}}},

    {"id": "head", "type": "turn3d", "parent": "head_roll",
     "center": {"part": "face", "at": [0.5, 0.55]},
     "yaw": {"param": "ParamAngleX", "scale": 0.5},
     "pitch": {"param": "ParamAngleY", "scale": 0.4}},

    {"id": "hair_front_bend", "type": "bend", "parent": "head",
     "root": {"part": "hair_front", "at": [0.5, 0.35]}, "tip": {"part": "hair_front", "at": [0.5, 1.0]},
     "segments": [{"ParamHairFront": 1.0}]},
    {"id": "hair_side_R_bend", "type": "bend", "parent": "head",
     "root": {"part": "hair_side_R", "at": [0.5, 0.0]}, "tip": {"part": "hair_side_R", "at": [0.5, 1.0]},
     "segments": [{"ParamHairSide1": 1.0}, {"ParamHairSide2": 1.0}]},
    {"id": "hair_side_L_bend", "type": "bend", "parent": "head",
     "root": {"part": "hair_side_L", "at": [0.5, 0.0]}, "tip": {"part": "hair_side_L", "at": [0.5, 1.0]},
     "segments": [{"ParamHairSide1": 1.0}, {"ParamHairSide2": 1.0}]},
    {"id": "hair_back_bend", "type": "bend", "parent": "head",
     "root": {"part": "hair_back", "at": [0.5, 0.3]}, "tip": {"part": "hair_back", "at": [0.5, 1.0]},
     "segments": [{"ParamHairBack1": 1.0}, {"ParamHairBack2": 1.0}]},
    {"id": "tassel_R_bend", "type": "bend", "parent": "head",
     "root": {"part": "tassel_R", "at": [0.5, 0.0]}, "tip": {"part": "tassel_R", "at": [0.5, 1.0]},
     "segments": [{"ParamTassel1": 1.0}, {"ParamTassel2": 1.0}]},
    {"id": "tassel_L_bend", "type": "bend", "parent": "head",
     "root": {"part": "tassel_L", "at": [0.5, 0.0]}, "tip": {"part": "tassel_L", "at": [0.5, 1.0]},
     "segments": [{"ParamTassel1": 1.0}, {"ParamTassel2": 1.0}]},

    {"id": "tail_bend", "type": "bend", "parent": "body",
     "root": {"part": "tail", "at": [0.95, 0.85]}, "tip": {"part": "tail", "at": [0.05, 0.3]},
     "segments": [{"ParamTail1": 1.0}, {"ParamTail2": 1.0}, {"ParamTail3": 1.0}]},
    {"id": "arm_R_bend", "type": "bend", "parent": "body",
     "root": {"part": "arm_R", "at": [0.8, 0.02]}, "tip": {"part": "arm_R", "at": [0.3, 0.95]},
     "segments": [{"ParamArmRSway": 1.0}]},
    {"id": "arm_L_bend", "type": "bend", "parent": "body",
     "root": {"part": "arm_L", "at": [0.2, 0.02]}, "tip": {"part": "arm_L", "at": [0.7, 0.95]},
     "segments": [{"ParamArmLSway": 1.0}]}
  ],

  "default_deformer": "body",

  "draw_order": [
    "hair_back", "tail", "neck", "leg_L", "leg_R", "skirt", "torso", "belt", "chest_ornament", "collar",
    "arm_R", "arm_L",
    "ear_R", "ear_L", "face", "cheek",
    "brow_R", "brow_L",
    "eye_white_R", "iris_R", "eye_highlight_R", "eyelash_upper_R", "eyelash_lower_R", "eyelash_R", "eye_closed_R",
    "eye_white_L", "iris_L", "eye_highlight_L", "eyelash_upper_L", "eyelash_lower_L", "eyelash_L", "eye_closed_L",
    "mouth_inner", "mouth_teeth", "mouth_tongue", "mouth_line_upper", "mouth_line_lower", "mouth_omega",
    "hair_side_R", "hair_side_L", "hair_front",
    "antler_R", "antler_L", "flower_R", "flower_L", "clip_R", "clip_L", "tassel_R", "tassel_L"
  ],

  "parts": {
    "hair_back": {"deformer": "hair_back_bend", "depth": {"type": "const", "z": {"part": "face", "w": -0.15}}},
    "neck": {"deformer": "body"},
    "tail": {"deformer": "tail_bend"},
    "torso": {"deformer": "body"},
    "arm_R": {"deformer": "arm_R_bend"},
    "arm_L": {"deformer": "arm_L_bend"},

    "face": {"deformer": "head",
             "depth": {"type": "sphere", "center": {"part": "face", "at": [0.5, 0.6]},
                       "radius": {"part": "face", "w": 0.62}, "z_scale": 0.6}},
    "ear_R": {"deformer": "head", "depth": {"type": "const", "z": {"part": "face", "w": -0.05}}},
    "ear_L": {"deformer": "head", "depth": {"type": "const", "z": {"part": "face", "w": -0.05}}},

    "brow_R": {"deformer": "head", "depth": "face",
               "keyforms": [{"params": ["ParamBrowRY"], "keys": [[-1, 0, 1]],
                             "forms": [{"translate": {"canvas_h": [0, 0.005]}}, {}, {"translate": {"canvas_h": [0, -0.007]}}]}]},
    "brow_L": {"deformer": "head", "depth": "face",
               "keyforms": [{"params": ["ParamBrowLY"], "keys": [[-1, 0, 1]],
                             "forms": [{"translate": {"canvas_h": [0, 0.005]}}, {}, {"translate": {"canvas_h": [0, -0.007]}}]}]},

    "eye_white_R": {"deformer": "head", "depth": "face",
                    "keyforms": [{"params": ["ParamEyeROpen"], "keys": [[0, 0.3, 1]],
                                  "forms": [{"scale": [1, 0.08], "pivot": {"part": "eye_white_R", "at": [0.5, 0.85]}, "opacity": 0},
                                            {"scale": [1, 0.35], "pivot": {"part": "eye_white_R", "at": [0.5, 0.85]}}, {}]}]},
    "iris_R": {"deformer": "head", "depth": "face", "clip": "eye_white_R",
               "keyforms": [{"params": ["ParamEyeBallX"], "keys": [[-1, 0, 1]],
                             "forms": [{"translate": {"part": "eye_white_R", "wh": [-0.2, 0]}}, {}, {"translate": {"part": "eye_white_R", "wh": [0.2, 0]}}]},
                            {"params": ["ParamEyeBallY"], "keys": [[-1, 0, 1]],
                             "forms": [{"translate": {"part": "eye_white_R", "wh": [0, 0.15]}}, {}, {"translate": {"part": "eye_white_R", "wh": [0, -0.15]}}]}]},
    "eyelash_R": {"deformer": "head", "depth": "face",
                  "keyforms": [{"params": ["ParamEyeROpen"], "keys": [[0, 0.3, 1]],
                                "forms": [{"scale": [1, 0.08], "pivot": {"part": "eye_white_R", "at": [0.5, 0.85]}, "opacity": 0},
                                          {"scale": [1, 0.35], "pivot": {"part": "eye_white_R", "at": [0.5, 0.85]}}, {}]}]},
    "eye_closed_R": {"deformer": "head", "depth": "face",
                     "keyforms": [{"params": ["ParamEyeROpen"], "keys": [[0, 0.3]], "forms": [{}, {"opacity": 0}]}]},

    "eye_white_L": {"deformer": "head", "depth": "face",
                    "keyforms": [{"params": ["ParamEyeLOpen"], "keys": [[0, 0.3, 1]],
                                  "forms": [{"scale": [1, 0.08], "pivot": {"part": "eye_white_L", "at": [0.5, 0.85]}, "opacity": 0},
                                            {"scale": [1, 0.35], "pivot": {"part": "eye_white_L", "at": [0.5, 0.85]}}, {}]}]},
    "iris_L": {"deformer": "head", "depth": "face", "clip": "eye_white_L",
               "keyforms": [{"params": ["ParamEyeBallX"], "keys": [[-1, 0, 1]],
                             "forms": [{"translate": {"part": "eye_white_L", "wh": [-0.2, 0]}}, {}, {"translate": {"part": "eye_white_L", "wh": [0.2, 0]}}]},
                            {"params": ["ParamEyeBallY"], "keys": [[-1, 0, 1]],
                             "forms": [{"translate": {"part": "eye_white_L", "wh": [0, 0.15]}}, {}, {"translate": {"part": "eye_white_L", "wh": [0, -0.15]}}]}]},
    "eyelash_L": {"deformer": "head", "depth": "face",
                  "keyforms": [{"params": ["ParamEyeLOpen"], "keys": [[0, 0.3, 1]],
                                "forms": [{"scale": [1, 0.08], "pivot": {"part": "eye_white_L", "at": [0.5, 0.85]}, "opacity": 0},
                                          {"scale": [1, 0.35], "pivot": {"part": "eye_white_L", "at": [0.5, 0.85]}}, {}]}]},
    "eye_closed_L": {"deformer": "head", "depth": "face",
                     "keyforms": [{"params": ["ParamEyeLOpen"], "keys": [[0, 0.3]], "forms": [{}, {"opacity": 0}]}]},

    "mouth_inner": {"deformer": "head", "depth": "face",
                    "keyforms": [{"params": ["ParamMouthOpenY"], "keys": [[0, 0.25, 1]],
                                  "forms": [{"scale": [0.6, 0.05], "pivot": {"self": [0.5, 0.1]}, "opacity": 0},
                                            {"scale": [0.75, 0.3], "pivot": {"self": [0.5, 0.1]}}, {}]},
                                 {"params": ["ParamMouthForm"], "keys": [[-1, 0, 1]],
                                  "forms": [{"scale": [0.85, 1.1], "pivot": {"self": [0.5, 0.1]}}, {},
                                            {"scale": [1.25, 0.85], "pivot": {"self": [0.5, 0.1]}}]}]},
    "mouth_omega": {"deformer": "head", "depth": "face",
                    "keyforms": [{"params": ["ParamMouthOpenY"], "keys": [[0, 0.3]], "forms": [{}, {"opacity": 0}]},
                                 {"params": ["ParamMouthForm"], "keys": [[-1, 0, 1]],
                                  "forms": [{"scale": [0.9, 1.0]}, {}, {"scale": [1.2, 1.0]}]}]},

    "hair_side_R": {"deformer": "hair_side_R_bend", "depth": {"type": "const", "z": {"part": "face", "w": 0.12}}},
    "hair_side_L": {"deformer": "hair_side_L_bend", "depth": {"type": "const", "z": {"part": "face", "w": 0.12}}},
    "hair_front": {"deformer": "hair_front_bend",
                   "depth": {"type": "sphere", "center": {"part": "face", "at": [0.5, 0.6]},
                             "radius": {"part": "face", "w": 0.95}, "z_scale": 0.55,
                             "offset": {"part": "face", "w": 0.02}}},

    "antler_R": {"deformer": "head", "depth": {"type": "const", "z": {"part": "face", "w": 0.1}}},
    "antler_L": {"deformer": "head", "depth": {"type": "const", "z": {"part": "face", "w": 0.1}}},
    "flower_R": {"deformer": "head", "depth": {"type": "const", "z": {"part": "face", "w": 0.15}}},
    "flower_L": {"deformer": "head", "depth": {"type": "const", "z": {"part": "face", "w": 0.15}}},
    "clip_R": {"deformer": "head", "depth": {"type": "const", "z": {"part": "face", "w": 0.05}}},
    "clip_L": {"deformer": "head", "depth": {"type": "const", "z": {"part": "face", "w": 0.05}}},
    "tassel_R": {"deformer": "tassel_R_bend", "depth": {"type": "const", "z": {"part": "face", "w": 0.05}}},
    "tassel_L": {"deformer": "tassel_L_bend", "depth": {"type": "const", "z": {"part": "face", "w": 0.05}}}
  },

  "physics": [
    {"id": "hair_front", "segments": 1, "gravity": 30, "damping": 0.18, "stiffness": 0.3,
     "inputs": [{"param": "ParamAngleX", "kind": "x", "weight": 0.02},
                {"param": "ParamBodyAngleX", "kind": "x", "weight": 0.04},
                {"param": "ParamAngleZ", "kind": "angle", "weight": 0.5}],
     "outputs": [{"param": "ParamHairFront", "segment": 0, "scale": 0.25}]},
    {"id": "hair_side", "segments": 2, "gravity": 30, "damping": 0.12, "stiffness": 0.1,
     "inputs": [{"param": "ParamAngleX", "kind": "x", "weight": 0.04},
                {"param": "ParamBodyAngleX", "kind": "x", "weight": 0.08},
                {"param": "ParamAngleZ", "kind": "angle", "weight": 0.5}],
     "outputs": [{"param": "ParamHairSide1", "segment": 0, "scale": 0.6},
                 {"param": "ParamHairSide2", "segment": 1, "scale": 0.6}]},
    {"id": "hair_back", "segments": 2, "gravity": 25, "damping": 0.1, "stiffness": 0.1,
     "inputs": [{"param": "ParamAngleX", "kind": "x", "weight": 0.03},
                {"param": "ParamBodyAngleX", "kind": "x", "weight": 0.08},
                {"param": "ParamAngleZ", "kind": "angle", "weight": 0.5},
                {"param": "ParamSway", "kind": "x", "weight": 0.25}],
     "outputs": [{"param": "ParamHairBack1", "segment": 0, "scale": 0.4},
                 {"param": "ParamHairBack2", "segment": 1, "scale": 0.4}]},
    {"id": "tail", "segments": 3, "gravity": 20, "damping": 0.08, "stiffness": 0.15,
     "inputs": [{"param": "ParamBodyAngleX", "kind": "x", "weight": 0.1},
                {"param": "ParamSway", "kind": "x", "weight": 0.8}],
     "outputs": [{"param": "ParamTail1", "segment": 0, "scale": 0.6},
                 {"param": "ParamTail2", "segment": 1, "scale": 0.7},
                 {"param": "ParamTail3", "segment": 2, "scale": 0.8}]},
    {"id": "tassels", "segments": 2, "gravity": 35, "damping": 0.1,
     "inputs": [{"param": "ParamAngleX", "kind": "x", "weight": 0.05},
                {"param": "ParamBodyAngleX", "kind": "x", "weight": 0.08},
                {"param": "ParamAngleZ", "kind": "angle", "weight": 0.5}],
     "outputs": [{"param": "ParamTassel1", "segment": 0, "scale": 1.0},
                 {"param": "ParamTassel2", "segment": 1, "scale": 1.0}]},
    {"id": "arms", "segments": 1, "gravity": 30, "damping": 0.15, "stiffness": 0.4,
     "inputs": [{"param": "ParamBodyAngleX", "kind": "x", "weight": 0.06},
                {"param": "ParamBodyAngleZ", "kind": "angle", "weight": 0.4}],
     "outputs": [{"param": "ParamArmRSway", "segment": 0, "scale": 0.35},
                 {"param": "ParamArmLSway", "segment": 0, "scale": 0.35}]}
  ]
}
